<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Systematic Testing</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=DM+Sans:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--sun:#FFD23F;--mint:#5EEAD4;--pink:#FF5E8A;--sky:#38BDF8;--text:#fff;
--head:'Bricolage Grotesque',system-ui,sans-serif;--body:'DM Sans',system-ui,sans-serif}
*{box-sizing:border-box;margin:0}
html,body{height:100%;overflow:hidden;background:#111;color:var(--text);font-family:var(--body)}
.slide{position:absolute;inset:0;padding:clamp(22px,6vw,100px);display:flex;flex-direction:column;justify-content:center;
 opacity:0;visibility:hidden;transition:opacity .5s,visibility .5s;overflow:hidden}
.slide.active{opacity:1;visibility:visible}
.g1{background:linear-gradient(135deg,#1A1446,#6A1B9A 60%,#FF5E8A)}
.g2{background:linear-gradient(135deg,#0F3D66,#12A5A0)}
.g3{background:linear-gradient(135deg,#C2410C,#9D174D)}
.g4{background:linear-gradient(135deg,#2B1B8A,#0EA5E9)}
.g5{background:linear-gradient(135deg,#064E3B,#4D7C0F)}
.g6{background:linear-gradient(135deg,#1E1B4B,#7C3AED)}
.g7{background:linear-gradient(135deg,#9A3412,#BE185D)}
.g8{background:linear-gradient(135deg,#0B1F4D,#5B21B6 60%,#DB2777)}
.slide>*{position:relative;z-index:2}
h1,h2,h3{font-family:var(--head);line-height:1.05}
h1{font-size:clamp(44px,10vw,150px);font-weight:800;letter-spacing:-.02em;text-shadow:0 6px 0 rgba(0,0,0,.18)}
h2{font-size:clamp(30px,5vw,72px);font-weight:800;margin-bottom:.5em;max-width:18ch}
h3{font-size:clamp(20px,2.4vw,34px);font-weight:800;margin-bottom:.3em}
p{font-size:clamp(16px,1.9vw,28px);line-height:1.45;max-width:34em}
.tag{display:inline-block;align-self:flex-start;background:var(--sun);color:#1b1b1b;font-weight:600;border-radius:99px;
 padding:.3em .9em;font-size:clamp(14px,1.4vw,20px);margin-bottom:1em}
.row{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:clamp(12px,2vw,26px);margin-top:.8em}
.card{padding:clamp(16px,2.2vw,32px);border-radius:26px;background:rgba(255,255,255,.16);backdrop-filter:blur(6px);
 border:3px solid rgba(255,255,255,.35);transition:transform .25s}
.card:hover{transform:translateY(-8px) rotate(-1.5deg)}
.card:nth-child(1){box-shadow:0 8px 0 var(--mint)}.card:nth-child(2){box-shadow:0 8px 0 var(--sun)}
.card:nth-child(3){box-shadow:0 8px 0 var(--pink)}.card:nth-child(4){box-shadow:0 8px 0 var(--sky)}
.emo{font-size:clamp(40px,5.5vw,84px);line-height:1;margin-bottom:.15em;display:inline-block}
.card:hover .emo{animation:wob .6s}
@keyframes wob{25%{transform:rotate(-14deg) scale(1.2)}75%{transform:rotate(14deg) scale(1.2)}}
.num{font-family:var(--head);font-weight:800;font-size:clamp(46px,6.5vw,100px);color:var(--sun);line-height:1;text-shadow:0 4px 0 rgba(0,0,0,.2)}
.note{margin-top:1em;font-family:var(--head);font-weight:800;font-size:clamp(22px,3vw,44px);color:var(--sun);max-width:24ch}
.line{background:rgba(255,255,255,.18);border:3px solid rgba(255,255,255,.35);border-radius:20px;padding:.6em 1em;margin-bottom:.6em;
 font-size:clamp(17px,2.3vw,32px);max-width:28em;opacity:0;transform:translateX(-40px) scale(.95);transition:opacity .5s,transform .5s}
.line.show{opacity:1;transform:none}
.in{opacity:0}
.active .in{animation:rise .7s var(--d,0s) cubic-bezier(.2,.9,.3,1.2) both}
@keyframes rise{from{opacity:0;transform:translateY(50px) scale(.9)}to{opacity:1;transform:none}}
/* floating emoji background */
.fl{position:absolute;z-index:1;font-size:clamp(28px,5vw,70px);opacity:.28;animation:float var(--t,9s) ease-in-out infinite alternate}
@keyframes float{from{transform:translateY(0) rotate(-12deg)}to{transform:translateY(-40px) rotate(14deg)}}
/* cover plane */
.plane{position:absolute;right:7%;top:12%;font-size:clamp(80px,14vw,220px);z-index:2;opacity:0;line-height:1}
.active .plane{animation:fly 2.2s .4s cubic-bezier(.3,.7,.3,1) both}
@keyframes fly{0%{opacity:0;transform:translate(-75vw,60vh) rotate(-30deg) scale(.3)}20%{opacity:1}100%{opacity:1;transform:none}}
/* quiz */
.opt{cursor:pointer;text-align:left;font:inherit;color:inherit;transition:transform .2s,background .3s}
.opt:hover{transform:scale(1.03)}
.opt.ok{background:#16A34A;border-color:#BBF7D0}.opt.bad{background:#DC2626;border-color:#FECACA}
.msg{min-height:1.6em;margin-top:.8em;font-family:var(--head);font-weight:800;font-size:clamp(20px,2.6vw,38px);color:var(--sun)}
/* lab */
.btn{cursor:pointer;font:inherit;font-weight:600;font-size:clamp(15px,1.7vw,24px);border:0;border-radius:99px;padding:.6em 1.4em;
 background:var(--sun);color:#1b1b1b;box-shadow:0 5px 0 rgba(0,0,0,.3);transition:transform .15s}
.btn:active{transform:translateY(4px);box-shadow:none}.btn.b2{background:var(--mint)}
.lane{position:relative;height:clamp(52px,8vh,84px);margin:.4em 0;border-bottom:4px dashed rgba(255,255,255,.4)}
.lane span{position:absolute;left:0;bottom:2px;font-size:clamp(34px,5vw,64px);transition:left 1.2s cubic-bezier(.2,.8,.3,1)}
.res{display:flex;gap:2em;flex-wrap:wrap;margin-top:.6em;font-size:clamp(15px,1.8vw,26px)}
.res b{color:var(--sun)}
#conf{position:fixed;inset:0;pointer-events:none;z-index:5}
#bar{position:fixed;left:0;top:0;height:7px;background:linear-gradient(90deg,var(--mint),var(--sun),var(--pink));width:0;transition:width .4s;z-index:9}
#count,#hint{position:fixed;bottom:14px;font-size:15px;opacity:.75;z-index:9}
#count{right:22px}#hint{left:22px}
#notes{position:fixed;left:0;right:0;bottom:0;background:rgba(0,0,0,.85);padding:1em 1.5em 2.4em;font-size:clamp(15px,1.7vw,22px);
 z-index:8;display:none;max-height:40vh;overflow:auto}
#notes.on{display:block}
@media (prefers-reduced-motion:reduce){.active .in,.active .plane,.fl{animation:none;opacity:1;transform:none}.fl{opacity:.28}.slide,.line{transition:none}}
</style>
</head>
<body>
<div id="bar"></div><canvas id="conf"></canvas>

<section class="slide g1" data-fl="🔬🧪✈️🌍⭐" data-note="Привет! Сегодня тема — Systematic Testing, то есть «системная проверка». Задайте классу вопрос: как узнать, что что-то действительно работает? Самолётик на экране — наш главный герой: с ним мы проведём эксперимент.">
 <div class="plane">✈️</div>
 <p class="tag in" style="--d:.1s">Global Perspectives</p>
 <h1 class="in" style="--d:.25s">Systematic<br>Testing</h1>
 <p class="in" style="--d:.5s;margin-top:.8em">How do we find out what really works? 🤔</p>
</section>

<section class="slide g2" data-fl="📋🧠🔍✅" data-note="Объясните: systematic testing — это проверка идеи по плану, а не «наугад». Три слова: organised (по порядку), fair (честно), repeatable (повторяемо — любой может сделать так же и получить такой же результат).">
 <p class="tag in">The idea</p>
 <h2 class="in" style="--d:.1s">Test with a plan, not by guessing</h2>
 <p class="in" style="--d:.25s">Systematic testing means checking an idea step by step, in an organised way, and writing down what happens.</p>
 <div class="row">
  <div class="card in" style="--d:.5s"><span class="emo">📋</span><h3>Organised</h3><p>We follow clear steps.</p></div>
  <div class="card in" style="--d:.7s"><span class="emo">⚖️</span><h3>Fair</h3><p>Same conditions for everyone.</p></div>
  <div class="card in" style="--d:.9s"><span class="emo">🔁</span><h3>Repeatable</h3><p>Others get the same result.</p></div>
 </div>
</section>

<section class="slide g3" data-fl="💉💧🌾☀️🌍" data-note="Покажите, что это не только школьная тема. Вакцины проверяют на многих людях, фильтры для воды тестируют снова и снова, фермеры проверяют семена, а учёные — солнечные панели. Спросите класс: что ещё в мире нужно проверять?">
 <p class="tag in">Why it matters</p>
 <h2 class="in" style="--d:.1s">It helps people all over the world</h2>
 <div class="row">
  <div class="card in" style="--d:.3s"><span class="emo">💉</span><h3>Medicine</h3><p>Vaccines are tested on many people first.</p></div>
  <div class="card in" style="--d:.5s"><span class="emo">💧</span><h3>Clean water</h3><p>Filters are tested again and again.</p></div>
  <div class="card in" style="--d:.7s"><span class="emo">🌾</span><h3>Farming</h3><p>Seeds are tested for drought.</p></div>
  <div class="card in" style="--d:.9s"><span class="emo">☀️</span><h3>Energy</h3><p>Solar panels are tested in all weather.</p></div>
 </div>
</section>

<section class="slide g4" data-fl="❓📝🧪📊" data-note="Четыре шага: 1) Ask — задать вопрос; 2) Plan — придумать, что и как проверять; 3) Test — провести тест аккуратно; 4) Record — записать результаты, сравнить и повторить. Карточки появляются по очереди — идите по шагам.">
 <p class="tag in">How to do it</p>
 <h2 class="in" style="--d:.1s">The 4 steps</h2>
 <div class="row">
  <div class="card in" style="--d:.3s"><div class="num">1</div><h3>Ask ❓</h3><p>What do we want to find out?</p></div>
  <div class="card in" style="--d:.7s"><div class="num">2</div><h3>Plan 📝</h3><p>Decide what to test and how.</p></div>
  <div class="card in" style="--d:1.1s"><div class="num">3</div><h3>Test 🧪</h3><p>Do the test carefully.</p></div>
  <div class="card in" style="--d:1.5s"><div class="num">4</div><h3>Record 📊</h3><p>Write results, compare, repeat.</p></div>
 </div>
</section>

<section class="slide g5" data-fl="⚖️🧐✅❌" data-note="Главное правило — fair test: меняем только ОДНО, всё остальное одинаково. Мини-игра: пусть класс выберет, какой тест честный. Правильный ответ — второй: там отличаются только крылья. В первом тесте разная бумага и разные люди бросают — непонятно, что повлияло.">
 <p class="tag in">Mini quiz</p>
 <h2 class="in" style="--d:.1s">Which test is fair? 🧐</h2>
 <div class="row" id="quiz">
  <button class="card opt in" style="--d:.3s" data-ok="0"><h3>Test A</h3><p>Big wings + thick paper, thrown by Ann. Small wings + thin paper, thrown by Tom.</p></button>
  <button class="card opt in" style="--d:.5s" data-ok="1"><h3>Test B</h3><p>Same paper, same person, same place. Only the wing size is different.</p></button>
 </div>
 <p class="msg" id="qmsg"></p>
</section>

<section class="slide g6" data-fl="✈️📏🎯📈" data-note="Виртуальная лаборатория. Нажимайте кнопки и бросайте самолётики. Обратите внимание: результаты каждый раз разные! Поэтому мы повторяем тест несколько раз и считаем среднее. Это симуляция — настоящий эксперимент будет на следующем слайде.">
 <p class="tag in">Virtual lab</p>
 <h2 class="in" style="--d:.1s">Throw it! Then throw it again 🎯</h2>
 <div class="lane in" style="--d:.3s"><span id="p1">✈️</span></div>
 <div class="lane in" style="--d:.4s"><span id="p2">🛩️</span></div>
 <div class="in" style="--d:.5s;display:flex;gap:1em;flex-wrap:wrap;margin-top:.6em">
  <button class="btn" id="t1">Throw: big wings</button>
  <button class="btn b2" id="t2">Throw: small wings</button>
  <button class="btn" id="rs" style="background:#fff">Reset</button>
 </div>
 <div class="res in" style="--d:.6s"><div>Big wings: <b id="r1">–</b></div><div>Small wings: <b id="r2">–</b></div></div>
 <p class="msg" id="lmsg">Simulation: every throw gives a different distance. That is why we repeat tests!</p>
</section>

<section class="slide g7" data-fl="📄✂️📏✏️" data-note="Практика для класса. Шаги появляются по клику (нажимайте пробел или кликайте). Раздайте листы бумаги и линейки: сделать 2 самолётика, бросить каждый 3 раза одинаково, измерить, записать и сравнить. В конце спросите: какой улетел дальше и почему?">
 <p class="tag in">Activity</p>
 <h2 class="in" style="--d:.1s">Your turn: the paper plane test 📄</h2>
 <div class="line">1️⃣ Make 2 planes: big wings and small wings.</div>
 <div class="line">2️⃣ Throw each plane 3 times, the same way.</div>
 <div class="line">3️⃣ Measure and write down every distance.</div>
 <div class="line">4️⃣ Compare: which flew further? Why?</div>
</section>

<section class="slide g8" data-fl="🎉⭐🏆🔬🎈" data-note="Подведите итог: Plan it — план; Change one thing — меняем одно; Record and repeat — записываем и повторяем. Слайд с конфетти — для вопросов класса. Нажмите N, чтобы скрыть или показать эти заметки.">
 <p class="tag in">Remember</p>
 <h2 class="in" style="--d:.1s">Test like a scientist 🔬</h2>
 <div class="row">
  <div class="card in" style="--d:.3s"><span class="emo">🗺️</span><h3>Plan it</h3><p>Know your question first.</p></div>
  <div class="card in" style="--d:.5s"><span class="emo">☝️</span><h3>Change one thing</h3><p>Keep everything else fair.</p></div>
  <div class="card in" style="--d:.7s"><span class="emo">📊</span><h3>Record and repeat</h3><p>Write results, try again.</p></div>
 </div>
 <p class="note in" style="--d:1.1s;font-size:clamp(36px,6vw,90px)">Questions? 🙋</p>
</section>

<div id="hint">← → / click · N = notes</div><div id="count"></div><div id="notes"></div>

<script>
const slides=[...document.querySelectorAll('.slide')];
let i=0;
const bar=document.getElementById('bar'),count=document.getElementById('count'),notes=document.getElementById('notes');

// floating emoji decoration
slides.forEach(s=>{
  [...(s.dataset.fl||'')].length&&Array.from(new Intl.Segmenter().segment(s.dataset.fl)).forEach((g,k)=>{
    for(let n=0;n<2;n++){
      const e=document.createElement('span');e.className='fl';e.textContent=g.segment;
      e.style.left=(Math.random()*92)+'%';e.style.top=(Math.random()*85)+'%';
      e.style.setProperty('--t',(6+Math.random()*7)+'s');e.style.animationDelay=(-Math.random()*6)+'s';
      s.appendChild(e);
    }
  });
});

function go(n){
  i=Math.max(0,Math.min(slides.length-1,n));
  slides.forEach((s,k)=>{
    const on=k===i;
    if(on&&!s.classList.contains('active')){
      s.querySelectorAll('.line').forEach(l=>l.classList.remove('show'));
      s.classList.remove('active');void s.offsetWidth;
    }
    s.classList.toggle('active',on);
  });
  bar.style.width=((i+1)/slides.length*100)+'%';
  count.textContent=(i+1)+' / '+slides.length;
  notes.textContent='📝 '+(slides[i].dataset.note||'');
  history.replaceState(null,'','#'+(i+1));
  if(i===slides.length-1)confetti();
}
function next(){
  const h=slides[i].querySelector('.line:not(.show)');
  if(h){h.classList.add('show');return}
  go(i+1);
}
const prev=()=>go(i-1);
addEventListener('keydown',e=>{
  if(['ArrowRight','ArrowDown','PageDown',' ','Enter'].includes(e.key)){e.preventDefault();next()}
  if(['ArrowLeft','ArrowUp','PageUp','Backspace'].includes(e.key)){e.preventDefault();prev()}
  if(e.key==='n'||e.key==='N')notes.classList.toggle('on');
});
addEventListener('click',e=>{
  if(e.target.closest('button,#notes'))return;
  e.clientX<innerWidth*.3?prev():next();
});
let x0=null;
addEventListener('touchstart',e=>{x0=e.touches[0].clientX},{passive:true});
addEventListener('touchend',e=>{
  if(x0===null)return;const d=e.changedTouches[0].clientX-x0;
  if(Math.abs(d)>60){d<0?next():prev()}x0=null;
});

// quiz
document.querySelectorAll('#quiz .opt').forEach(b=>b.addEventListener('click',e=>{
  e.stopPropagation();
  const ok=b.dataset.ok==='1';
  b.classList.add(ok?'ok':'bad');
  document.getElementById('qmsg').textContent=ok?'✅ Yes! Only ONE thing changes: the wings.'
   :'❌ Not fair: too many things are different. Try the other one!';
  if(ok)confetti();
}));

// virtual lab
const L={1:[],2:[]};
const avg=a=>a.length?(a.reduce((x,y)=>x+y,0)/a.length).toFixed(1)+' m (avg of '+a.length+')':'–';
function thr(k){
  const d=6+Math.random()*7; L[k].push(+d.toFixed(1));
  const p=document.getElementById('p'+k);
  p.style.transition='none';p.style.left='0';void p.offsetWidth;
  p.style.transition='';p.style.left=(d/13*80)+'%';
  document.getElementById('r'+k).textContent=d.toFixed(1)+' m  |  '+avg(L[k]);
}
t1.onclick=e=>{e.stopPropagation();thr(1)};
t2.onclick=e=>{e.stopPropagation();thr(2)};
rs.onclick=e=>{e.stopPropagation();L[1]=[];L[2]=[];['1','2'].forEach(k=>{document.getElementById('p'+k).style.left='0';document.getElementById('r'+k).textContent='–'})};

// confetti
const cv=document.getElementById('conf'),cx=cv.getContext('2d');let parts=[],raf;
function confetti(){
  cv.width=innerWidth;cv.height=innerHeight;cancelAnimationFrame(raf);
  const cols=['#FFD23F','#5EEAD4','#FF5E8A','#38BDF8','#fff'];
  parts=Array.from({length:140},()=>({x:Math.random()*cv.width,y:-20-Math.random()*cv.height*.5,
    vx:(Math.random()-.5)*4,vy:2+Math.random()*4,s:6+Math.random()*8,c:cols[Math.random()*5|0],r:Math.random()*6}));
  let t=0;
  (function tick(){
    cx.clearRect(0,0,cv.width,cv.height);
    parts.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.r+=.15;cx.fillStyle=p.c;cx.save();cx.translate(p.x,p.y);cx.rotate(p.r);cx.fillRect(-p.s/2,-p.s/4,p.s,p.s/2);cx.restore()});
    if(++t<260)raf=requestAnimationFrame(tick);else cx.clearRect(0,0,cv.width,cv.height);
  })();
}
go((parseInt(location.hash.slice(1))||1)-1);
</script>
</body>
</html>
