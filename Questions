// 300 уникальных задач (средний уровень), генерируются при старте; дубликаты отсекаются
const r=(a,b)=>Math.floor(Math.random()*(b-a+1))+a;
const G=[
()=>{const a=r(120,899),b=r(120,899);return[`${a} + ${b} = ?`,a+b]},
()=>{const a=r(300,999),b=r(100,299);return[`${a} − ${b} = ?`,a-b]},
()=>{const a=r(12,29),b=r(3,9);return[`${a} × ${b} = ?`,a*b]},
()=>{const b=r(3,12),c=r(6,25);return[`${b*c} ÷ ${b} = ?`,c]},
()=>{const x=r(2,15),a=r(2,9),b=r(1,30);return[`Решите: ${a}x + ${b} = ${a*x+b}. x = ?`,x]},
()=>{const x=r(3,20),a=r(2,9),b=r(1,20);return[`Решите: ${a}x − ${b} = ${a*x-b}. x = ?`,x]},
()=>{const p=[10,20,25,50,5][r(0,4)],n=r(2,40)*20;return[`Сколько будет ${p}% от ${n}?`,p*n/100]},
()=>{const a=r(2,30),d=r(2,12);return[`Продолжи ряд: ${[0,1,2,3].map(i=>a+i*d).join(', ')}, ?`,a+4*d]},
()=>{const a=r(2,6),k=r(2,4);return[`Продолжи ряд: ${[0,1,2,3].map(i=>a*k**i).join(', ')}, ?`,a*k**4]},
()=>{const a=r(11,35);return[`${a}² = ?`,a*a]},
()=>{const a=r(6,40);return[`√${a*a} = ?`,a]},
()=>{const a=r(3,25),b=r(3,25);return[`Периметр прямоугольника ${a}×${b} см (в см)?`,2*(a+b)]},
()=>{const a=r(3,25),b=r(3,25);return[`Площадь прямоугольника ${a}×${b} см (в см²)?`,a*b]},
()=>{const m=r(8,60),a=r(2,7);return[`Среднее арифметическое чисел ${m-a}, ${m}, ${m+a}, ${m}?`,m]},
()=>{const k=r(3,9),n=r(12,30),e=r(3,n-1);return[`В ${k} коробках по ${n} яблок. ${e} съели. Сколько осталось?`,k*n-e]},
()=>{const t=r(2,9),v=r(30,95);return[`Скорость ${v} км/ч. Сколько км за ${t} ч?`,v*t]},
()=>{const a=r(2,9),b=r(2,9),c=r(2,9);return[`${a} + ${b} × ${c} = ?`,a+b*c]},
()=>{const a=r(2,9),b=r(2,9),c=r(2,9);return[`(${a} + ${b}) × ${c} = ?`,(a+b)*c]},
()=>{const n=r(3,12);return[`Сколько диагоналей у выпуклого ${n}-угольника?`,n*(n-3)/2]},
()=>{const a=r(2,9),n=r(2,5);return[`${a}^${n} = ?`,a**n]},
];
const seen=new Set(),Q=[];
for(let t=0;Q.length<300&&t<50000;t++){const x=G[r(0,G.length-1)]();if(!seen.has(x[0])){seen.add(x[0]);Q.push(x)}}
module.exports=Q;
